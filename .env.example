# StarRadar 环境变量示例
# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）

# GitHub Token（用于数据采集 + 加星/Fork 操作）
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_yo…here

# LLM API Key（用于中文摘要 / 趋势解读 / 查询扩展）
# 留空 = 不用 LLM，解读自动降级为规则文本（免费）。个人版管道仍可用访问者自填 Key。
LLM_API_KEY=sk-you…here

# 彻底关掉 LLM 调用（零花费；即使上面填了 Key 也生效）
# LLM_DISABLED=1

# LLM 模型（可选，默认 gpt-4o-mini；推荐 deepseek-v4-flash 性价比高）
LLM_MODEL=deepseek-v4-flash

# LLM Base URL（可选，模型名前缀自动推断；也可手动指定）
# LLM_BASE_URL=https://api.deepseek.com

# 调试模式（可选，默认 0）
# DEBUG=1

# ===== 本机访问码（可选） =====
# 首启自动随机生成 6 位码并写入 data/profile/access_code.txt（服务启动时会打印）。
# 想固定访问码时再设置：
# STARRADAR_ACCESS_CODE=你的6位码

# ===== GitHub OAuth App（登录，可选） =====
# 内置默认 client_id 已可用（设备流零配置，克隆者无需任何填写）。
# 仅当你想要「跳转授权」（点一下 Authorize 自动回跳，平常网站体验）时才需要注册
# OAuth App 并填入下面两项（Callback URL 填 http://127.0.0.1/api/oauth/callback）：
# GH_OAUTH_CLIENT_ID=Ov23_你的Client_ID
# GH_OAUTH_CLIENT_SECRET=***   # 机密，切勿提交到仓库

# ===== 未来服务器部署铺垫（可选，本地无需配置） =====
# OAUTH_REDIRECT_BASE=https://你的域名      # 跳转回调固定地址（默认按 Host 推导）
# CORS 白名单（逗号分隔）。默认收紧为 Pages 域名 + 本机回环地址；
# 有其他前端要跨域调用本机 API 时，用下面的变量追加：
# CORS_ORIGINS=https://2bingling.github.io,https://你的域名
